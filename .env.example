# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/portfolio
SERVICE_API_KEY=change-me

# Telegram bot
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_WEBHOOK_SECRET=change-me
ADMIN_TELEGRAM_ID=123456789
GROQ_API_KEY=change-me
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
BACKEND_URL=http://localhost:8000

# Optional backend source synchronization
DEVTO_USERNAME=mikesplore
GITHUB_USERNAME=mikesplore
GITHUB_TOKEN=

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=portfolio-assets
R2_PUBLIC_BASE_URL=https://cdn.example.com
FRONTEND_ORIGIN=http://localhost:5173
# Multiple browser origins may be comma-separated.
